#!/bin/sh
# Opens the RadioKiosk interface full screen in the first browser that is installed.
URL="${RADIOKIOSK_URL:-http://localhost:8080}"
# Right after login the service may still be starting; a browser that comes
# first would show an error page and stay on it.
if command -v curl >/dev/null; then
  for _ in $(seq 60); do
    curl -s -o /dev/null -m 2 "$URL/api/state" && break
    sleep 1
  done
fi

# Chromium assumes X11 unless told otherwise
PLATFORM=""
[ -n "$WAYLAND_DISPLAY" ] && PLATFORM="--ozone-platform=wayland"

# How many interfaces on this computer are connected to the service; nothing while the
# service cannot be asked. A phone on remote control must not pass for the kiosk's own window.
shown() {
  curl -s -m 2 "$URL/api/clients" 2>/dev/null | sed -n 's/.*"local": *\([0-9][0-9]*\).*/\1/p'
}

for browser in chromium-browser chromium google-chrome; do
  command -v "$browser" >/dev/null || continue
  # On a Pi 3 Chromium's network process crashes now and then, mostly in the busy first
  # minutes after boot, and the page is lost: the window stays white. So the window is
  # watched for as long as it is open and started again when the interface is gone from it.
  LOG="${XDG_RUNTIME_DIR:-/tmp}/radiokiosk-browser.log"
  while :; do
    # --password-store: a kiosk has no passwords to keep; without it a keyring dialog covers the screen
    "$browser" --kiosk --app="$URL" $PLATFORM --noerrdialogs \
      --disable-session-crashed-bubble --disable-pinch --overscroll-history-navigation=0 \
      --disable-features=Translate --password-store=basic >"$LOG" 2>&1 &
    pid=$!
    command -v curl >/dev/null || { wait "$pid"; exit; }
    missing=0
    while :; do
      sleep 5
      kill -0 "$pid" 2>/dev/null || exit     # closed by the user
      case "$(shown)" in
        "") ;;                               # the service is restarting, as after an update: nothing to tell
        0) missing=$((missing + 5)) ;;
        *) missing=0 ;;
      esac
      # a page still loading gets a minute and a half, a crash on record much less
      limit=90
      grep -q "Network service crashed" "$LOG" 2>/dev/null && limit=20
      [ "$missing" -ge "$limit" ] && break
    done
    kill "$pid" 2>/dev/null
    sleep 3
  done
done
if command -v firefox >/dev/null; then
  exec firefox --kiosk "$URL"
fi
exec xdg-open "$URL"
